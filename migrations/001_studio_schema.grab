use data

set db to data.open using "main"

set migration to data.migrate using db, [record {version: 1, name: "grex_builder_studio_v01", steps: ["CREATE TABLE IF NOT EXISTS studio_layouts (slot_scope TEXT NOT NULL, status TEXT NOT NULL, document_json TEXT NOT NULL, css_hash TEXT NOT NULL DEFAULT '', updated_at TEXT NOT NULL, PRIMARY KEY (slot_scope, status))", "CREATE TABLE IF NOT EXISTS studio_commands (id INTEGER PRIMARY KEY, actor TEXT NOT NULL, command_json TEXT NOT NULL, created_at TEXT NOT NULL)"]}]

show migration
